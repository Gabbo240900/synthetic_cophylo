   "id": "f3432c15",
   "metadata": {},
   "outputs": [],
   "source": [
    "from ete3 import Tree\n",
    "\n",
    "def count_leaves(newick):\n",
    "    try:\n",
    "        # Ensure a semicolon\n",
    "        if not newick.strip().endswith(\";\"):\n",
    "            newick = newick + \";\"\n",
    "            \n",
    "        t = Tree(newick, format=1)   # format=1 allows internal node names\n",
    "        return len(t.get_leaves())\n",
    "    except Exception as e:\n",
    "        print(\"ETE error:\", e)\n",
    "        return 0\n",
    "\n",
    "\n",
    "def build_event_row(entry):\n",
    "    stats = entry[\"sim_stats\"]\n",
    "\n",
    "    event_keys = [\"Horizontal_Gene_Transfer\", \"Loss\", \"Duplication\", \"Speciation\"]\n",
    "    event_counts = {k: stats.get(k, 0) for k in event_keys}\n",
    "\n",
    "    total_events = sum(event_counts.values())\n",
    "\n",
    "    # FIXED leaf counting\n",
    "    parasite_leaves = count_leaves(entry[\"parasite_newick\"])\n",
    "    host_leaves = count_leaves(entry[\"host_newick\"])\n",
    "\n",
    "    return {\n",
    "        \"filename\": entry[\"filename\"],\n",
    "        \"parasite_leaves\": parasite_leaves,\n",
    "        \"host_leaves\": host_leaves,\n",
    "        \"total_events\": total_events,\n",
    "        **event_counts\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "d579418f",
   "metadata": {},
   "outputs": [],
   "source": [
    "final_dataset = []\n",
    "\n",
    "for entry in datasets_asymmetree_cosp:   # your new list\n",
    "    final_dataset.append(build_event_row(entry))"
   ]
  },
